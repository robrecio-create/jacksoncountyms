---
interface Props {
  variant?: 'hero' | 'section' | 'footer';
}

const { variant = 'section' } = Astro.props;
const beehiivEmbedId = '4906c669-42a9-4e32-b7cc-4cab0b22fe13';
---

<div class={`newsletter-signup newsletter-${variant}`} id="newsletter-signup">
  <div class="newsletter-content">
    {variant !== 'footer' && (
      <>
        <span class="newsletter-eyebrow">Stay Connected</span>
        <h3>Get the Jackson County Weekly</h3>
        <p>Local events, deals & business spotlights every Friday.</p>
      </>
    )}
    {variant === 'footer' && (
      <>
        <h4>Jackson County Weekly</h4>
        <p>Local events, deals & business spotlights every Friday</p>
      </>
    )}
  </div>

  <div class="newsletter-embed">
    <iframe
      src={`https://subscribe-forms.beehiiv.com/${beehiivEmbedId}`}
      class="beehiiv-embed"
      data-test-id="beehiiv-embed"
      frameborder="0"
      scrolling="no"
    ></iframe>
  </div>
</div>

<script async src="https://subscribe-forms.beehiiv.com/embed.js"></script>
<script type="text/javascript" async src="https://subscribe-forms.beehiiv.com/attribution.js"></script>

<style>
  .newsletter-signup {
    padding: 3rem;
    background: linear-gradient(135deg, var(--navy) 0%, var(--navy-mid) 100%);
    border-radius: var(--radius-xl);
    position: relative;
    overflow: hidden;
  }

  .newsletter-signup::before {
    content: '';
    position: absolute;
    top: -50%;
    right: -30%;
    width: 80%;
    height: 200%;
    background: radial-gradient(circle, rgba(26,127,122,0.1) 0%, transparent 60%);
    pointer-events: none;
  }

  .newsletter-content {
    text-align: center;
    margin-bottom: 1.5rem;
    position: relative;
    z-index: 1;
  }

  .newsletter-eyebrow {
    display: inline-block;
    font-weight: 700;
    font-size: 0.7rem;
    letter-spacing: 2.5px;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 0.5rem;
  }

  .newsletter-content h3 {
    font-family: var(--font-heading);
    font-size: 1.6rem;
    font-weight: 700;
    color: var(--white);
    margin-bottom: 0.5rem;
  }

  .newsletter-content p {
    color: rgba(255,255,255,0.7);
    font-size: 0.95rem;
    max-width: 400px;
    margin: 0 auto;
  }

  .newsletter-embed {
    position: relative;
    z-index: 1;
    display: flex;
    justify-content: center;
  }

  .beehiiv-embed {
    width: 100%;
    max-width: 560px;
    height: 291px;
    margin: 0 auto;
    border-radius: 0px;
    background-color: transparent;
    box-shadow: none;
    border: none;
  }

  /* Footer variant */
  .newsletter-footer {
    padding: 0;
    background: transparent;
    border-radius: 0;
  }

  .newsletter-footer::before {
    display: none;
  }

  .newsletter-footer .newsletter-content {
    text-align: left;
    margin-bottom: 0.75rem;
  }

  .newsletter-footer .newsletter-content h4 {
    font-family: var(--font-heading);
    color: var(--white);
    font-size: 1rem;
    margin-bottom: 0.25rem;
  }

  .newsletter-footer .newsletter-content p {
    color: rgba(255,255,255,0.55);
    font-size: 0.85rem;
    margin: 0;
    max-width: none;
  }

  .newsletter-footer .newsletter-embed {
    justify-content: flex-start;
  }

  .newsletter-footer .beehiiv-embed {
    max-width: 100%;
    height: 200px;
  }

  @media (max-width: 700px) {
    .newsletter-signup {
      padding: 2rem 1.5rem;
    }

    .beehiiv-embed {
      height: 320px;
    }
  }
</style>
