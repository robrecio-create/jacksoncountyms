---
interface Props {
  variant?: 'hero' | 'section' | 'footer';
}

const { variant = 'section' } = Astro.props;
const publicationId = 'pub_da041fd5-70c0-4270-9e19-0df6757e0218';
---

<div class={`newsletter-signup newsletter-${variant}`} id="newsletter-signup">
  <div class="newsletter-content">
    {variant !== 'footer' && (
      <>
        <span class="newsletter-eyebrow">Stay Connected</span>
        <h3>Get the Jackson County MS Connect Weekly</h3>
        <p>Local events, deals & business spotlights every Friday.</p>
      </>
    )}
    {variant === 'footer' && (
      <>
        <h4>Jackson County MS Connect Weekly</h4>
        <p>Local events, deals & business spotlights every Friday</p>
      </>
    )}
  </div>

  {variant !== 'footer' && (
    <form class="newsletter-form" id="newsletter-form" data-publication={publicationId}>
      <input 
        type="email" 
        name="email" 
        placeholder="Enter your email" 
        required 
        class="newsletter-input"
      />
      <button type="submit" class="newsletter-button">
        <span class="btn-text">Subscribe</span>
        <span class="btn-loading" style="display:none;">...</span>
      </button>
    </form>
    <p class="newsletter-status" id="newsletter-status"></p>
  )}

  {variant === 'footer' && (
    <a href="https://jacksoncountyms.beehiiv.com/subscribe" class="newsletter-cta" target="_blank" rel="noopener">
      Subscribe →
    </a>
  )}
</div>

<script>
  const form = document.getElementById('newsletter-form') as HTMLFormElement;
  const status = document.getElementById('newsletter-status');
  
  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      const emailInput = form.querySelector('input[name="email"]') as HTMLInputElement;
      const button = form.querySelector('button') as HTMLButtonElement;
      const btnText = button.querySelector('.btn-text') as HTMLElement;
      const btnLoading = button.querySelector('.btn-loading') as HTMLElement;
      
      const email = emailInput.value;
      
      // Show loading
      btnText.style.display = 'none';
      btnLoading.style.display = 'inline';
      button.disabled = true;
      
      try {
        const response = await fetch('/api/newsletter-subscribe', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email })
        });
        
        const result = await response.json();
        
        if (response.ok) {
          if (status) {
            status.textContent = '✓ You\'re subscribed!';
            status.className = 'newsletter-status success';
          }
          emailInput.value = '';
        } else {
          if (status) {
            status.textContent = result.error || 'Something went wrong';
            status.className = 'newsletter-status error';
          }
        }
      } catch (err) {
        if (status) {
          status.textContent = 'Network error. Try again.';
          status.className = 'newsletter-status error';
        }
      }
      
      // Reset button
      btnText.style.display = 'inline';
      btnLoading.style.display = 'none';
      button.disabled = false;
    });
  }
</script>

<style>
  .newsletter-signup {
    padding: 1.25rem 1.5rem;
    background: linear-gradient(135deg, var(--navy) 0%, var(--navy-mid) 100%);
    border-radius: var(--radius-lg);
    position: relative;
    overflow: hidden;
    max-width: 500px;
    margin: 0 auto;
  }

  .newsletter-content {
    text-align: center;
    margin-bottom: 0.75rem;
  }

  .newsletter-eyebrow {
    display: inline-block;
    font-weight: 700;
    font-size: 0.6rem;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 0.25rem;
  }

  .newsletter-content h3 {
    font-family: var(--font-heading);
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--white);
    margin-bottom: 0.2rem;
  }

  .newsletter-content p {
    color: rgba(255,255,255,0.7);
    font-size: 0.8rem;
    margin: 0;
  }

  .newsletter-form {
    display: flex;
    gap: 0.5rem;
    max-width: 400px;
    margin: 0 auto;
  }

  .newsletter-input {
    flex: 1;
    padding: 0.6rem 0.9rem;
    border: none;
    border-radius: var(--radius-md);
    font-size: 0.85rem;
    outline: none;
  }

  .newsletter-input:focus {
    box-shadow: 0 0 0 2px var(--gold);
  }

  .newsletter-button {
    background: var(--gold);
    color: var(--navy);
    border: none;
    padding: 0.6rem 1.2rem;
    border-radius: var(--radius-md);
    font-weight: 600;
    font-size: 0.85rem;
    cursor: pointer;
    transition: background 0.2s ease;
    white-space: nowrap;
  }

  .newsletter-button:hover {
    background: var(--gold-light, #e6c547);
  }

  .newsletter-button:disabled {
    opacity: 0.7;
    cursor: not-allowed;
  }

  .newsletter-status {
    text-align: center;
    font-size: 0.8rem;
    margin-top: 0.5rem;
    min-height: 1.2em;
  }

  .newsletter-status.success {
    color: #4ade80;
  }

  .newsletter-status.error {
    color: #f87171;
  }

  /* Footer variant */
  .newsletter-footer {
    padding: 0;
    background: transparent;
    border-radius: 0;
    max-width: none;
  }

  .newsletter-footer .newsletter-content {
    text-align: left;
    margin-bottom: 0.5rem;
  }

  .newsletter-footer .newsletter-content h4 {
    font-family: var(--font-heading);
    color: var(--white);
    font-size: 0.95rem;
    margin-bottom: 0.2rem;
  }

  .newsletter-footer .newsletter-content p {
    color: rgba(255,255,255,0.55);
    font-size: 0.8rem;
  }

  .newsletter-cta {
    display: inline-block;
    background: var(--gold);
    color: var(--navy);
    padding: 0.5rem 1rem;
    border-radius: var(--radius-md);
    font-weight: 600;
    font-size: 0.85rem;
    text-decoration: none;
    transition: background 0.2s ease;
  }

  .newsletter-cta:hover {
    background: var(--gold-light, #e6c547);
  }

  @media (max-width: 500px) {
    .newsletter-form {
      flex-direction: column;
    }
  }
</style>
